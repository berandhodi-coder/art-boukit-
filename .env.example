# ==============================================================================
# ART BOUQUET — Local Environment Template
# Copy this file to .env.local for local development. Never commit real secrets.
# ==============================================================================

# Supabase Database Configuration
# ------------------------------------------------------------------------------
# 1. Project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# 2. Anonymous Key (public safe, found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Service Role Key (SERVER-ONLY SECRET, never prefix with NEXT_PUBLIC_)
# Used exclusively server-side in Server Actions to insert orders while keeping
# Row Level Security (RLS) closed to anonymous browser access.
SUPABASE_SERVICE_ROLE_KEY=

# OmniRoute — AI model gateway only (not wired as a website dependency)
# Keep the key server-side. Do not prefix with NEXT_PUBLIC_.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
